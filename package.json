{
  "name": "gabura-estudio-dublagem",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "description": "Estúdio de dublagem do Gaburaverso: grava vozes, aplica efeitos por personagem e exporta para o jogo.",
  "license": "MIT",
  "scripts": {
    "dev": "vite",
